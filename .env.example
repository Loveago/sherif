# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/datahub_ghana?schema=public

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Server
PORT=4000
FRONTEND_URL=http://localhost:3000

# Feature Flags
MOCK_PAYMENTS=true
MOCK_PROVIDER=true

# Admin Credentials (Change in production)
ADMIN_EMAIL=admin@datahubgh.com
ADMIN_PASSWORD=Admin@123

# Demo Agent Credentials (Change in production)
DEMO_AGENT_EMAIL=agent@datahubgh.com
DEMO_AGENT_PASSWORD=Agent@123

# Paystack Integration
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here

# Providers
SHANK_API_KEY=
SHANK_API_BASE_URL=https://agent.skanka5.com/api/v1
BUNDLE_PORTAL_API_KEY=
BUNDLE_PORTAL_API_BASE_URL=https://api.bundleportal.com/v2
BUNDLE_PORTAL_WEBHOOK_SECRET=
TSKCONNECT_API_KEY=
TSKCONNECT_API_BASE_URL=https://tsk05.net/v1
TSKCONNECT_WEBHOOK_SECRET=
